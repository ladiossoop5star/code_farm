#!/usr/bin/env python3
"""Find a DUT's IPv4 addresses by matching its recorded MAC against ARP replies."""

import argparse
from ipaddress import IPv4Address
from pathlib import Path
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument('--interface', metavar='IFACE', help='scan the IPv4 subnet on this interface')
    source.add_argument('--from', dest='capture', type=Path, metavar='FILE', help='read saved arp-scan output')
    parser.add_argument('mac', type=str.lower, help='DUT MAC, for example 02:00:00:00:08:42')
    args = parser.parse_args()
    if not re.fullmatch(r'(?:[0-9a-f]{2}:){5}[0-9a-f]{2}', args.mac):
        parser.error('expected a MAC in xx:xx:xx:xx:xx:xx format')

    try:
        if args.capture is not None:
            replies = args.capture.read_text(encoding='utf-8')
        else:
            scan = subprocess.run(
                ['arp-scan', f'--interface={args.interface}', '--localnet', '--plain', '--quiet'],
                capture_output=True, text=True, check=True,
            )
            replies = scan.stdout
    except subprocess.CalledProcessError as error:
        print(f'dut-ip: arp-scan exited with status {error.returncode}', file=sys.stderr)
        if error.stderr:
            print(error.stderr.rstrip(), file=sys.stderr)
        return 2
    except (OSError, UnicodeError) as error:
        print(f'dut-ip: {error}', file=sys.stderr)
        return 2

    matches = set()
    for line in replies.splitlines():
        columns = line.split(maxsplit=2)
        if len(columns) < 2 or columns[1].lower() != args.mac:
            continue
        try:
            matches.add(IPv4Address(columns[0]))
        except ValueError:
            continue

    if not matches:
        print(f'dut-ip: no IPv4 reply for {args.mac}', file=sys.stderr)
        return 1

    for address in sorted(matches):
        print(address)
    return 0


if __name__ == '__main__':
    sys.exit(main())
